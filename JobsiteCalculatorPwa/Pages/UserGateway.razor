@page "/user-gateway"
@inject JobsiteCalculatorPwa.Services.AuthService AuthService

<div class="split-side split-middle" style="height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 2rem;">
    <div class="split-label-container" style="width: 100%; max-width: 400px; text-align: center;">
        <AuthorizeView>
            <Authorized>
                <div class="split-tag" style="background-color: var(--highlight-color, #ff9800); color: #111; display: inline-block; padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem;">Active Session</div>
                <div class="split-title" style="font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 2px;">AI Console</div>
                
                <div class="dashboard-stats" style="margin-top: 1.5rem; text-align: center;">
                    <div class="stat-box" style="padding: 1.5rem; background: rgba(0,0,0,0.5); border: 1px solid #333; border-radius: 8px;">
                        <span style="font-size: 0.9rem; color: #888; text-transform: uppercase; letter-spacing: 2px;">Credit Balance</span>
                        <div style="font-size: 3rem; font-weight: 800; color: #fff; margin: 0.5rem 0;">
                            @((AuthService.CurrentBalanceCents / 100.0).ToString("C2"))
                        </div>
                        <span style="font-size: 0.8rem; color: #666;">Metering Active</span>
                    </div>

                    <button class="btn-top-up" style="margin-top: 1.5rem; width: 100%; padding: 1rem; background: transparent; color: #fff; border: 1px solid #fff; text-transform: uppercase; letter-spacing: 2px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; border-radius: 4px;">
                        Top Up Credits
                    </button>
                    
                    <button class="btn-logout" @onclick="AuthService.Logout" style="margin-top: 1rem; width: 100%; padding: 0.75rem; background: transparent; color: #666; border: none; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: color 0.3s ease;">
                        Sign Out
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="split-tag" style="background-color: #333; color: #fff; display: inline-block; padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem;">Gateway</div>
                <div class="split-title" style="font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 2px;">Operator Login</div>
                <div class="split-desc" style="margin-bottom: 2rem; color: #9ca3af; font-size: 0.9rem; line-height: 1.5;">Authenticate to access the Pre-Paid AI Console and telemetry systems.</div>
                
                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                    <div style="display: flex; flex-direction: column; gap: 1rem; text-align: left;">
                        <div class="input-group">
                            <label style="color: #9ca3af; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 0.5rem;">Email Address</label>
                            <InputText @bind-Value="loginModel.Email" style="width: 100%; padding: 0.8rem; background: rgba(0,0,0,0.4); border: 1px solid #333; color: #fff; border-radius: 4px; outline: none; box-sizing: border-box;" placeholder="operator@dondlingergc.com" />
                        </div>
                        
                        <div class="input-group">
                            <label style="color: #9ca3af; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 0.5rem;">Passphrase</label>
                            <InputText @bind-Value="loginModel.Password" type="password" style="width: 100%; padding: 0.8rem; background: rgba(0,0,0,0.4); border: 1px solid #333; color: #fff; border-radius: 4px; outline: none; box-sizing: border-box;" placeholder="••••••••••••" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div style="color: #ef4444; font-size: 0.85rem; margin-top: 0.5rem;">@errorMessage</div>
                        }

                        <button type="submit" disabled="@isSubmitting" style="margin-top: 1rem; padding: 1rem; background: #fff; color: #000; border: none; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; border-radius: 4px; transition: opacity 0.3s ease;">
                            @(isSubmitting ? "Authenticating..." : "Initialize Session")
                        </button>
                    </div>
                </EditForm>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private bool isSubmitting = false;
    private string? errorMessage;

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;
        StateHasChanged();

        var success = await AuthService.LoginAsync(loginModel.Email, loginModel.Password);
        
        if (!success)
        {
            errorMessage = "Invalid credentials or unauthorized.";
        }
        
        isSubmitting = false;
        StateHasChanged();
    }

    public class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
