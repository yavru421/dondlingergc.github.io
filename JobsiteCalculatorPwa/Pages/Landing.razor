@page "/portal"

<div id="portal-split" class="portal-stage" style="height: 100vh; width: 100vw; display: flex; flex-direction: column;">
    <div class="theme-split" id="split-wrapper" style="display: flex; flex: 1; width: 100%;">
        
        <div class="split-side split-left" style="flex: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 2rem; border-right: 1px solid rgba(255,255,255,0.1); transition: background 0.3s ease;">
            <div class="split-label-container">
                <div class="split-tag" style="background-color: #333; color: #fff; display: inline-block; padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem;">PWA Catalog</div>
                <div class="split-title" style="font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 2px;">Dondlinger Digital Database</div>
                <div class="split-desc" style="color: #9ca3af; font-size: 0.9rem; line-height: 1.5;">Access the curated engineering catalog of purpose-built progressive web applications.</div>
                
                <a href="/estimator" style="display: inline-block; margin-top: 1.5rem; padding: 0.75rem 1.5rem; background: rgba(255,255,255,0.1); color: #fff; text-decoration: none; border-radius: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Launch Estimator</a>
            </div>
        </div>

        <div class="split-side split-middle" style="flex: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 2rem; transition: background 0.3s ease;">
            <div class="split-label-container" style="text-align: center;">
                <div class="split-tag" style="background-color: var(--highlight-color, #ff9800); color: #111; display: inline-block; padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem;">Authentication</div>
                <div class="split-title" style="font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 2px;">Global Account</div>
                <div class="split-desc" style="color: #9ca3af; font-size: 0.9rem; line-height: 1.5; margin-bottom: 1.5rem;">Secure SSO Login / Signup for all Digital Database services.</div>
                
                <a href="https://personalization.dondlingergc.com" style="display: inline-block; padding: 0.75rem 1.5rem; background: #fff; color: #000; text-decoration: none; border-radius: 4px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; transition: opacity 0.3s ease;">Login / Signup</a>
            </div>
        </div>

        <div class="split-side split-right" style="flex: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 2rem; border-left: 1px solid rgba(255,255,255,0.1); transition: background 0.3s ease;">
            <div class="split-label-container">
                <div class="split-tag" style="background-color: #333; color: #fff; display: inline-block; padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem;">Live Telemetry</div>
                <div class="split-title" style="font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 2px;">WaZWeather</div>
                <div class="split-desc" style="color: #9ca3af; font-size: 0.9rem; line-height: 1.5; margin-bottom: 1.5rem;">Real-time local forecasting, hydrology flow, and atmospheric metrics for Wazeecha.</div>
                
                <a href="https://wazweather.dondlingergc.com" class="glass-portal-card" style="display: block; padding: 1.25rem; background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; text-decoration: none; color: #fff; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);">
                    <div style="font-size: 0.95rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #00bcd4; margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.5rem;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Launch WaZWeather PWA
                    </div>
                    <div style="font-size: 0.8rem; color: #9ca3af; line-height: 1.4;">Real-time local forecasting, hydrology flow, and atmospheric metrics at wazweather.dondlingergc.com.</div>
                </a>
            </div>
        </div>
    </div>
</div>
